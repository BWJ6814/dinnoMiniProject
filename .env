# ──────────────────────────────────────────────────────────────────────────────
# DDWorks-Mini 환경 변수 설정 파일
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Neo4j 그래프 DB ──────────────────────────────────────────────────────────
# Docker Compose로 실행 시 아래 기본값을 그대로 사용하세요
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ddworks1234

# ── LLM API ─────────────────────────────────────────────────────────────────
# "google", "anthropic", "openai" 중 하나를 선택하세요
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# Google Gemini API Key (https://aistudio.google.com/ 에서 무료 발급)
GOOGLE_API_KEY=AIzaSyDTYJgTqZ0vCgNVBOvqC2li-UjbpAftk2s

# Anthropic API Key (LLM_PROVIDER=anthropic로 변경 시 사용)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (LLM_PROVIDER=openai로 변경 시 사용)
OPENAI_API_KEY=sk-your-key-here

# ── 마이크로서비스 URL ───────────────────────────────────────────────────────
# Docker Compose 환경에서는 서비스명을 호스트로 사용 (예: http://agent-service:8001)
# 로컬 개발 시 localhost 사용
AGENT_SERVICE_URL=http://localhost:8001
MAIN_SERVICE_URL=http://localhost:8000

# ── 정합성 검증 설정 ─────────────────────────────────────────────────────────
# As-Built vs As-Designed 허용 오차 (단위: 미터, 기본값 5cm)
CONSISTENCY_TOLERANCE_M=0.05
